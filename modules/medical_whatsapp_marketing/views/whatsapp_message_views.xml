<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista List -->
        <record id="view_medical_whatsapp_message_list" model="ir.ui.view">
            <field name="name">medical.whatsapp.message.list</field>
            <field name="model">medical.whatsapp.message</field>
            <field name="arch" type="xml">
                <list decoration-success="state=='sent'" decoration-danger="state=='error'">
                    <field name="name"/>
                    <field name="create_date"/>
                    <field name="send_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </list>
        </record>

        <!-- Vista Form -->
        <record id="view_medical_whatsapp_message_form" model="ir.ui.view">
            <field name="name">medical.whatsapp.message.form</field>
            <field name="model">medical.whatsapp.message</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_send_whatsapp" string="Enviar Campaña WhatsApp" type="object" class="btn-primary" invisible="state == 'sent'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de Campaña"/></h1>
                        </div>
                        <notebook>
                            <page string="Destinatarios">
                                <field name="partner_ids" widget="many2many">
                                    <list>
                                        <field name="name"/>
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Contenido y Multimedia">
                                <group>
                                    <field name="message_body" placeholder="Escribe el texto o pie de foto aquí..." nolabel="1" colspan="2"/>
                                </group>
                                <group string="Imagen Adjunta (Opcional)">
                                    <field name="image_attachment" filename="image_filename" widget="image" class="oe_avatar"/>
                                    <field name="image_filename" invisible="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Configuración res.config.settings -->
        <record id="view_medical_whatsapp_config_settings" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.medical.whatsapp</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="WhatsApp Marketing" string="WhatsApp Marketing" name="medical_whatsapp_marketing">
                        <block title="Credenciales Oficiales de Meta Cloud API">
                            <setting string="Identificador de Teléfono" help="Phone Number ID provisto por Meta Developers">
                                <field name="meta_phone_number_id" placeholder="Ej: 1323133694212769"/>
                            </setting>
                            <setting string="Token de Acceso Permanente" help="Token de Sistema generado en Meta Business">
                                <field name="meta_access_token" placeholder="EAAS..."/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <!-- Acciones y Menús -->
        <record id="action_medical_whatsapp_message" model="ir.actions.act_window">
            <field name="name">Mensajes WhatsApp</field>
            <field name="res_model">medical.whatsapp.message</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_medical_whatsapp_settings" model="ir.actions.act_window">
            <field name="name">Ajustes WhatsApp</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module': 'medical_whatsapp_marketing'}</field>
        </record>

        <menuitem id="menu_medical_marketing" name="Marketing" parent="medical_management.menu_medical_management" sequence="35"/>
        <menuitem id="menu_medical_whatsapp_messages" name="Mensajes WhatsApp" parent="menu_medical_marketing" action="action_medical_whatsapp_message" sequence="10"/>
        <menuitem id="menu_medical_whatsapp_settings" name="Ajustes WhatsApp" parent="menu_medical_marketing" action="action_medical_whatsapp_settings" sequence="20"/>
    </data>
</odoo>