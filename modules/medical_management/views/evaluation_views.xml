<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_medical_evaluation_list" model="ir.ui.view">
            <field name="name">medical.evaluation.list</field>
            <field name="model">medical.evaluation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="specialty_id"/>
                    <field name="date"/>
                    <field name="practitioner_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_medical_evaluation_form" model="ir.ui.view">
            <field name="name">medical.evaluation.form</field>
            <field name="model">medical.evaluation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_complete" type="object" string="Completar Evaluación" 
                                class="btn-primary" invisible="state != 'draft'"/>
                        
                        <button name="action_create_treatment" type="object" string="Crear Tratamiento" 
                                class="btn-primary" invisible="state != 'completed'" 
                                confirm="¿Está seguro de crear un tratamiento basado en esta evaluación?"/>
                        
                        <button name="action_view_treatment" type="object" string="Ver Tratamiento" 
                                class="btn-secondary" invisible="not treatment_id"/>

                         <button name="action_view_clinical_record" type="object" string="Ver Ficha Clínica" 
                                class="btn-secondary"/> 
                        <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="patient_id" required="1" readonly="1"/>
                                <field name="specialty_id" required="1" readonly="1"/>
                            </group>
                            <group>
                                <field name="date" required="1" readonly="1"/>
                                <field name="practitioner_id" required="1" readonly="1"/>
                                 <field name="clinical_record_id" readonly="1"/> 
                                <field name="template_id" required="1" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Evaluación" invisible="not template_id">
                                <field name="answer_ids" mode="list,form" nolabel="1" create="0">
                                    <list editable="bottom">
                                        <field name="question_id" readonly="1" force_save="1"/>
                                        <field name="question_type" invisible="1"/>
                                        <field name="boolean_answer" invisible="question_type != 'boolean'" string="Respuesta"/>
                                        <field name="text_answer" invisible="question_type != 'text'" string="Respuesta"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="question_id" readonly="1"/>
                                            <field name="question_type" invisible="1"/>
                                            <field name="boolean_answer" invisible="question_type != 'boolean'" string="Respuesta Sí/No"/>
                                            <field name="text_answer" invisible="question_type != 'text'" nolabel="1" placeholder="Ingrese la respuesta..."/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Imagen Adjunta">
                                <group>
                                    <field name="attachment_image" filename="attachment_filename" string="Imagen"/>
                                    <field name="attachment_filename" invisible="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_medical_evaluation" model="ir.actions.act_window">
            <field name="name">Evaluaciones Médicas</field>
            <field name="res_model">medical.evaluation</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_medical_evaluation_list"/>
        </record>
    </data>
</odoo>