<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista list para pacientes -->
        <record id="view_medical_patient_tree" model="ir.ui.view">
            <field name="name">medical.patient.tree</field>
            <field name="model">medical.patient</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="gender"/>
                    <field name="birth_date" readonly="1" force_save="1"/>
                    <field name="blood_type"/>
                </list>
            </field>
        </record>

        <!-- Vista form para pacientes -->
        <record id="view_medical_patient_form" model="ir.ui.view">
            <field name="name">medical.patient.form</field>
            <field name="model">medical.patient</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" required="1"/>
                                <field name="gender"/>
                                <field name="birth_date"/>
                            </group>
                            <group>
                                <field name="blood_type"/>
                                <field name="skin_color"/>
                            </group>
                        </group>
                        <group string="Historial Médico">
                            <field name="allergies" nolabel="1" placeholder="Lista de alergias conocidas..."/>
                            <field name="medical_notes" nolabel="1" placeholder="Notas médicas generales del paciente..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción para pacientes -->
        <record id="action_medical_patient" model="ir.actions.act_window">
            <field name="name">Pacientes</field>
            <field name="res_model">medical.patient</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_medical_patient_tree"/>
        </record>
    </data>
</odoo>