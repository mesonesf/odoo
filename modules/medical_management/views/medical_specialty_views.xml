<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Especialidades Médicas - List -->
        <record id="view_medical_specialty_tree" model="ir.ui.view">
            <field name="name">medical.specialty.tree</field>
            <field name="model">medical.specialty</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Especialidades Médicas - Form -->
        <record id="view_medical_specialty_form" model="ir.ui.view">
            <field name="name">medical.specialty.form</field>
            <field name="model">medical.specialty</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción para Especialidades -->
        <record id="action_medical_specialty" model="ir.actions.act_window">
            <field name="name">Especialidades Médicas</field>
            <field name="res_model">medical.specialty</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_medical_specialty_tree"/>
        </record>
    </data>
</odoo>