<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_pe_edi" model="ir.ui.view">
        <field name="name">account.move.form.l10n.pe.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_send_pse" 
                        string="Enviar al PSE" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'posted' or l10n_pe_edi_status == 'accepted'"/>
                
                <button name="action_show_payload" 
                        string="Ver JSON (Debug)" 
                        type="object" 
                        class="btn-secondary" 
                        invisible="state != 'posted'"/>
            </xpath>

            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="l10n_pe_cuo" string="CUO SUNAT"/>
                <field name="l10n_pe_edi_status" widget="badge" decoration-success="l10n_pe_edi_status == 'accepted'" decoration-danger="l10n_pe_edi_status == 'rejected'" decoration-info="l10n_pe_edi_status == 'no_sent'"/>
                <field name="l10n_pe_edi_ticket"/>
                <field name="l10n_pe_edi_response" invisible="not l10n_pe_edi_response"/>
                
                <separator string="Configuración SUNAT (Catálogos)"/>
                <field name="l10n_pe_credit_note_type" invisible="move_type != 'out_refund'"/>
                <field name="l10n_pe_debit_note_type" invisible="1"/> <field name="l10n_pe_detraction_code" placeholder="Ej: 022"/>
                <field name="l10n_pe_detraction_amount" widget="monetary"/>
            </xpath>

        </field>
    </record>
</odoo>