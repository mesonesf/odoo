<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payload_debug_form" model="ir.ui.view">
        <field name="name">payload.debug.form</field>
        <field name="model">payload.debug</field>
        <field name="arch" type="xml">
            <form string="Detalle del Payload UBL 2.1">
                <sheet>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="JSON Estructurado (Para el PSE)">
                            <field name="payload_data" widget="code" readonly="1"/>
                        </page>
                        <page string="Datos de Líneas (Diagnóstico)">
                            <field name="line_details" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>