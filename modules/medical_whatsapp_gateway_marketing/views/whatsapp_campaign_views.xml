<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista List -->
        <record id="view_medical_whatsapp_campaign_list" model="ir.ui.view">
            <field name="name">medical.whatsapp.campaign.list</field>
            <field name="model">medical.whatsapp.campaign</field>
            <field name="arch" type="xml">
                <list decoration-success="state=='sent'" decoration-danger="state=='error'">
                    <field name="name"/>
                    <field name="gateway_id"/>
                    <field name="template_id"/>
                    <field name="create_date"/>
                    <field name="send_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="view_medical_whatsapp_campaign_form" model="ir.ui.view">
            <field name="name">medical.whatsapp.campaign.form</field>
            <field name="model">medical.whatsapp.campaign</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_send_campaign" string="Enviar Campaña Masiva" type="object" class="btn-primary" invisible="state == 'sent'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de Campaña"/></h1>
                        </div>
                        <group>
                            <field name="gateway_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}" invisible="not gateway_id"/>
                        </group>
                        <notebook>
                            <page string="Destinatarios (Pacientes)">
                                <field name="partner_ids" widget="many2many">
                                    <list>
                                        <field name="name"/>
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Contenido Multimedia y Mensaje">
                                <group>
                                    <field name="message_body" placeholder="Escribe información adicional o variables de la plantilla..." nolabel="1" colspan="2"/>
                                </group>
                                <group string="Imagen Adjunta (Opcional)">
                                    <field name="image_attachment" filename="image_filename" widget="image" class="oe_avatar"/>
                                    <field name="image_filename" invisible="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acciones y Menú -->
        <record id="action_medical_whatsapp_campaign" model="ir.actions.act_window">
            <field name="name">Campañas de Marketing</field>
            <field name="res_model">medical.whatsapp.campaign</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_medical_whatsapp_campaigns" name="Campañas WhatsApp" parent="medical_management.menu_medical_management" action="action_medical_whatsapp_campaign" sequence="36"/>
    </data>
</odoo>