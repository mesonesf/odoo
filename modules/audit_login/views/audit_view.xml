<odoo>
    <record id="view_audit_login_tree" model="ir.ui.view">
        <field name="name">audit.login.log.tree</field>
        <field name="model">audit.login.log</field>
        <field name="arch" type="xml">
            <list string="Auditoria de Logins" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="country_code" optional="show"/> 
                <field name="user_agent" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_audit_login_search" model="ir.ui.view">
        <field name="name">audit.login.log.search</field>
        <field name="model">audit.login.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs">
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="country_code"/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Usuario" name="group_by_user" context="{'group_by':'user_id'}"/>
                    <filter string="País" name="group_by_country" context="{'group_by':'country_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_login" model="ir.actions.act_window">
        <field name="name">Auditoria de Logins</field>
        <field name="res_model">audit.login.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_audit_login"
              name="Auditoria Logins"
              parent="base.menu_users"
              action="action_audit_login"
              sequence="100"
              groups="base.group_system"/>
</odoo>