<odoo>
    <record id="view_quotation_tree_inherit_crm_v4" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.crm.v4</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="es_cotizacion_crm" string="¿Es CRM?" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_crm_simplified_v4" model="ir.ui.view">
        <field name="name">sale.order.form.crm.simplified.v4</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                <attribute name="column_invisible">0</attribute>
                <attribute name="string">Producto (Padre)</attribute>
                <attribute name="widget">many2one</attribute> <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="es_cotizacion_crm" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_quotations_crm_v4" model="ir.actions.act_window">
        <field name="name">Cotizaciones CRM</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{
            'default_es_cotizacion_crm': True,
            'disable_product_configurator': True
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale.view_quotation_tree_with_onboarding')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_order_form_crm_simplified_v4')})]"/>
    </record>

    <menuitem id="menu_sale_quotations_crm" 
              name="Cotizaciones CRM" 
              action="action_quotations_crm_v4" 
              parent="crm.crm_menu_sales" 
              sequence="10"/>
</odoo>