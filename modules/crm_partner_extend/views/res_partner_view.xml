<odoo>
    <record id="view_partner_form_extend_v3" model="ir.ui.view">
        <field name="name">res.partner.form.extend.v3</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='vat']" position="after">
                <button name="action_buscar_ruc" 
                        type="object" 
                        string=" Consultar SUNAT" 
                        icon="fa-search" 
                        class="btn-primary" 
                        invisible="not vat"/>
            </xpath>

            <xpath expr="//group[@name='container_row_2']" position="after">
                <group string="Datos SUNAT &amp; Perfil" col="2">
                    <group string="Fiscal (SUNAT)">
                        <field name="estado_contribuyente" widget="badge" 
                               decoration-success="estado_contribuyente == 'ACTIVO'"
                               decoration-danger="estado_contribuyente in ['BAJA_OFICIO', 'BAJA_DEFINITIVA']"
                               decoration-warning="estado_contribuyente == 'SUSPENSION'"/>
                        <field name="condicion_contribuyente" widget="badge" 
                               decoration-success="condicion_contribuyente == 'HABIDO'"
                               decoration-danger="condicion_contribuyente == 'NO_HABIDO'"/>
                        <field name="numero_trabajadores"/>
                        <field name="tamano_empresa"/>
                    </group>
                    <group string="Perfilación CRM">
                        <field name="riesgo_crediticio" widget="priority"/>
                        <field name="tipo_cuenta" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//field[@name='industry_id']" position="attributes">
                <attribute name="string">Rubro/Sector</attribute>
            </xpath>

        </field>
    </record>
</odoo>