<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_usd_form" model="ir.ui.view">
        <field name="name">product.template.usd.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='list_price']" position="after">
                
                <field name="currency_usd_id" invisible="1"/>
                
                <label for="price_usd" string="Precio Venta USD"/>
                <div class="o_row">
                    <field name="price_usd" widget="monetary" options="{'currency_field': 'currency_usd_id'}"/>
                    <div class="text-muted">
                        (Referencial o Fijo)
                    </div>
                </div>
                
            </xpath>
        </field>
    </record>
</odoo>