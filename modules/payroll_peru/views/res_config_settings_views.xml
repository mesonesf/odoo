<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_peru" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.peru</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Nómina" string="Nómina" data-key="payroll">
                    <h2 class="mt16">Localización Perú</h2>
                    <div class="row mt16 o_settings_container" name="peru_localization_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="peru_parameters">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Parámetros Nacionales</span>
                                <div class="text-muted">
                                    Configuración de valores legales para el cálculo de planilla.
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label string="UIT Actual" for="peru_uit" class="col-lg-4 o_light_label"/>
                                        <field name="peru_uit" class="oe_inline"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="RMV Actual" for="peru_rmv" class="col-lg-4 o_light_label"/>
                                        <field name="peru_rmv" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>