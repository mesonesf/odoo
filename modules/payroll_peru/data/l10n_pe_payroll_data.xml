<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="BASIC" model="hr.salary.rule.category">
            <field name="name">Básico</field>
            <field name="code">BASIC</field>
        </record>

        <record id="ALW" model="hr.salary.rule.category">
            <field name="name">Asignaciones</field>
            <field name="code">ALW</field>
        </record>

        <record id="DED" model="hr.salary.rule.category">
            <field name="name">Deducciones</field>
            <field name="code">DED</field>
        </record>

        <record id="NET" model="hr.salary.rule.category">
            <field name="name">Neto</field>
            <field name="code">NET</field>
        </record>

        <record id="pe_category_comp_v4" model="hr.salary.rule.category">
            <field name="name">Aportes Empleador (Perú)</field>
            <field name="code">COMP_PE</field>
        </record>

        <record id="pe_rule_basic_v4" model="hr.salary.rule">
            <field name="name">PERU - Sueldo Básico</field>
            <field name="code">BASIC_PE</field>
            <field name="category_id" ref="payroll_peru.BASIC"/>
            <field name="sequence">1</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage</field>
        </record>

        <record id="pe_rule_asig_fam_v4" model="hr.salary.rule">
            <field name="name">PERU - Asignación Familiar</field>
            <field name="code">ALW_ASF_PE</field> 
            <field name="category_id" ref="payroll_peru.ALW"/>
            <field name="sequence">10</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.has_family_allowance</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
rmv = float(payslip.env['ir.config_parameter'].sudo().get_param('payroll_peru.peru_rmv', 1025.0))
result = rmv * 0.10
            </field>
        </record>
    </data>
</odoo>