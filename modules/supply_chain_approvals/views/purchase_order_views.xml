<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_approval_form" model="ir.ui.view">
        <field name="name">purchase.order.approval.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <field name="is_user_selector" invisible="1"/>
                <field name="is_user_confirmer" invisible="1"/>
                <field name="is_current_user_the_selector" invisible="1"/>
                <field name="requisition_has_winner" invisible="1"/>
                <field name="is_winning_quote" invisible="1"/>

                <button name="action_select_winner" string="🌟 Seleccionar como Ganadora" type="object" class="btn-warning" invisible="is_winning_quote or requisition_has_winner or state != 'draft' or not is_user_selector"/>
                <button name="action_undo_winner" string="❌ Quitar Medalla" type="object" class="btn-secondary" invisible="not is_winning_quote or state != 'draft' or not is_current_user_the_selector"/>
                
                <button name="action_request_approval" string="Solicitar Aprobación" type="object" class="oe_highlight" invisible="approval_status != 'draft' or not is_winning_quote"/>
                
                <button name="button_approve_wizard" string="Firmar (Aprobar)" type="object" class="btn-success" invisible="not is_current_user_approver"/>
                <button name="button_reject_wizard" string="Rechazar" type="object" class="btn-danger" invisible="not is_current_user_approver"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="before">
                <field name="approval_status" widget="statusbar" statusbar_visible="draft,to_approve,approved"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state not in ['draft', 'sent']</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">is_winning_quote</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_winning_quote" readonly="1" decoration-bf="1" decoration-success="1" invisible="not is_winning_quote"/>
                <field name="selector_id" readonly="1" invisible="not is_winning_quote"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Ruta de Aprobación">
                    <group>
                        <group string="Estado Actual">
                            <field name="route_id" readonly="1"/>
                            <field name="current_step_id" readonly="1"/>
                            <field name="is_current_user_approver" invisible="1"/>
                        </group>
                        <group string="Firmas del Paso Actual">
                            <field name="approver_ids" widget="many2many_tags" readonly="1"/>
                            <field name="approved_user_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="action_aprobacion_cotizaciones" model="ir.actions.act_window">
        <field name="name">Aprobación de Cotizaciones</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requisition_id', '!=', False)]</field>
        <field name="context">{'search_default_requisition_id': 1}</field>
    </record>

    <menuitem id="menu_aprobacion_cotizaciones"
              name="Aprobación de Cotizaciones"
              parent="purchase.menu_procurement_management"
              action="action_aprobacion_cotizaciones"
              sequence="2"/>
</odoo>