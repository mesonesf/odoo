<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_approval_form" model="ir.ui.view">
        <field name="name">stock.picking.form.auditoria</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_mark_received"
                        string="Marcar como Recibido"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'done' or received_by_id"/>
                        
                <button name="action_mark_reviewed"
                        string="Marcar como Revisado"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'done' or reviewed_by_id"/>
            </xpath>

            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Auditoría de Recepción">
                    <field name="received_by_id"/>
                    <field name="reviewed_by_id"/>
                </group>
            </xpath>
            
        </field>
    </record>
</odoo>