<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_route_form" model="ir.ui.view">
        <field name="name">approval.route.form</field>
        <field name="model">approval.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Pasos Secuenciales">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_route" model="ir.actions.act_window">
        <field name="name">Configurar Rutas de Aprobación</field>
        <field name="res_model">approval.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_supply_chain_approvals_config" 
              name="Rutas de Aprobación" 
              parent="purchase.menu_purchase_config" 
              action="action_approval_route" 
              groups="supply_chain_approvals.group_approval_config_manager"
              sequence="100"/>
</odoo>