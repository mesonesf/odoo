<odoo>
    <record id="module_category_sc_approvals" model="ir.module.category">
        <field name="name">Aprobaciones Supply Chain</field>
        <field name="description">Gestión de permisos para el flujo de aprobaciones.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_approval_config_manager" model="res.groups">
        <field name="name">Gestor de Configuración (Asigna Aprobadores)</field>
        <field name="category_id" ref="module_category_sc_approvals"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>