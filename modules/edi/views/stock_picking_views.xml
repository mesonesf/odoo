<odoo>
    <record id="view_picking_form_inherit_flota" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.flota</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Añadir campos en una nueva pestaña -->
            <xpath expr="//page[@name='note']" position="before">
                <page name="transport_info" string="Datos de Transporte">
                    <group>
                        <field name="vehicle_id_guia" widget="selection"/>  <!-- Usar widget de selección -->
                        <!--<field name="driver_id"/> -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
