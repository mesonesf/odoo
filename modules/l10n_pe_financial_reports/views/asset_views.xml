<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_peru_form" model="ir.ui.view">
        <field name="name">account.asset.peru.v3.form</field>
        <field name="model">account.asset.peru.v3</field>
        <field name="arch" type="xml">
            <form string="Activo Fijo">
                <header>
                    <button name="compute_depreciation_board" string="Calcular Depreciación" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_post_pending_depreciation" string="Contabilizar Cuotas Vencidas" type="object" class="oe_highlight" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del Activo"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_line_id" options="{'no_create': True}"/>
                            <field name="purchase_date"/>
                            <field name="purchase_value"/>
                            <field name="salvage_value"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="method_period"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contabilidad">
                            <group>
                                <field name="asset_account_id"/>
                                <field name="depreciation_account_id"/>
                                <field name="accumulated_account_id"/>
                                <field name="journal_id"/>
                            </group>
                        </page>
                        <page string="Tabla de Depreciación">
                            <field name="depreciation_line_ids" readonly="1">
                                <list>
                                    <field name="depreciation_date"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="is_posted"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_asset_peru_list" model="ir.ui.view">
        <field name="name">account.asset.peru.v3.list</field>
        <field name="model">account.asset.peru.v3</field>
        <field name="arch" type="xml">
            <list string="Activos Fijos">
                <field name="name"/>
                <field name="purchase_date"/>
                <field name="purchase_value"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_account_asset_peru" model="ir.actions.act_window">
        <field name="name">Activos Fijos Perú</field>
        <field name="res_model">account.asset.peru.v3</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_asset_peru" name="Registro de Activos" parent="account.menu_finance_entries" action="action_account_asset_peru" sequence="100"/>
</odoo>