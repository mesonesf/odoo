<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_financial" model="ir.actions.report">
        <field name="name">Estados Financieros (NIIF)</field>
        <field name="model">financial.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pe_financial_reports.report_template_view</field>
        <field name="report_file">l10n_pe_financial_reports.report_template_view</field>
        <field name="binding_model_id" ref="model_financial_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_template_view">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Arial', sans-serif; font-size: 11px;">
                    
                    <div class="text-center" style="border-bottom: 2px solid black; margin-bottom: 20px;">
                        <h4 t-if="data['report_type'] == 'balance'">ESTADO DE SITUACIÓN FINANCIERA</h4>
                        <h4 t-if="data['report_type'] == 'pyl'">ESTADO DE RESULTADOS POR NATURALEZA</h4>
                        <h4 t-if="data['report_type'] == 'patrimonio'">ESTADO DE CAMBIOS EN EL PATRIMONIO</h4>
                        <h4 t-if="data['report_type'] == 'diario'">LIBRO DIARIO</h4>
                        <h4 t-if="data['report_type'] == 'mayor'">LIBRO MAYOR</h4>
                        <h4 t-if="data['report_type'] == 'notas'">NOTAS A LOS ESTADOS FINANCIEROS</h4>
                        <h4 t-if="data['report_type'] == 'flujo'">ESTADO DE FLUJOS DE EFECTIVO</h4>
                        <p>Periodo: Del <span t-esc="data['date_from']"/> Al <span t-esc="data['date_to']"/></p>
                    </div>

                    <t t-if="data['report_type'] == 'balance'">
                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr class="font-weight-bold"><td>ACTIVO CORRIENTE</td><td/></tr>
                                    <tr t-foreach="act_corriente" t-as="a">
                                        <td class="pl-3"><span t-esc="a['name']"/></td>
                                        <td class="text-right"><span t-esc="a['balance'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr class="font-weight-bold border-top"><td>Total Activo Corriente</td><td class="text-right"><span t-esc="total_act_c or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    
                                    <tr class="font-weight-bold mt-2"><td>ACTIVO NO CORRIENTE</td><td/></tr>
                                    <tr>
                                        <td class="pl-3">Propiedades, Planta y Equipo (Costo)</td>
                                        <td class="text-right"><span t-esc="propiedad_planta_equipo or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="pl-3">(-) Depreciación Acumulada</td>
                                        <td class="text-right text-danger">
                                            (<span t-esc="abs(depreciacion_acumulada or 0.0)" t-options='{"widget": "float", "precision": 2}'/>)
                                        </td>
                                    </tr>
                                    <tr t-foreach="act_no_corriente" t-as="anc">
                                        <t t-if="anc['code'] not in ['33', '39']">
                                            <td class="pl-3"><span t-esc="anc['name']"/></td>
                                            <td class="text-right"><span t-esc="anc['balance'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </t>
                                    </tr>
                                    
                                    <tr class="font-weight-bold border-top"><td>Total Activo No Corriente</td><td class="text-right"><span t-esc="total_act_nc or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    <tr class="table-active font-weight-bold"><td>TOTAL ACTIVO</td><td class="text-right"><span t-esc="total_activo or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                </table>
                            </div>

                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr class="font-weight-bold"><td>PASIVO CORRIENTE</td><td/></tr>
                                    <tr t-foreach="pas_corriente" t-as="pc">
                                        <td class="pl-3"><span t-esc="pc['name']"/></td>
                                        <td class="text-right"><span t-esc="-pc['balance'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr class="font-weight-bold border-top"><td>Total Pasivo Corriente</td><td class="text-right"><span t-esc="total_pas_c or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    
                                    <tr class="font-weight-bold mt-2"><td>PASIVO NO CORRIENTE</td><td/></tr>
                                    <tr t-foreach="pas_no_corriente" t-as="pnc">
                                        <td class="pl-3"><span t-esc="pnc['name']"/></td>
                                        <td class="text-right"><span t-esc="-pnc['balance'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr class="font-weight-bold border-top"><td>Total Pasivo No Corriente</td><td class="text-right"><span t-esc="total_pas_nc or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>

                                    <tr class="font-weight-bold mt-2"><td>PATRIMONIO</td><td/></tr>
                                    <tr t-foreach="patrimonio" t-as="pat">
                                        <td class="pl-3"><span t-esc="pat['name']"/></td>
                                        <td class="text-right"><span t-esc="-pat['balance'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="pl-3"><i>Resultado del Ejercicio (Utilidad/Pérdida)</i></td>
                                        <td class="text-right"><i><span t-esc="utilidad_neta or 0.0" t-options='{"widget": "float", "precision": 2}'/></i></td>
                                    </tr>
                                    <tr class="font-weight-bold border-top"><td>Total Patrimonio</td><td class="text-right"><span t-esc="total_pat or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>

                                    <tr class="table-active font-weight-bold mt-4"><td>TOTAL PASIVO Y PATRIMONIO</td><td class="text-right"><span t-esc="total_pas_pat or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                </table>
                            </div>
                        </div>
                    </t>

                    <t t-if="data['report_type'] == 'pyl'">
                        <table class="table table-sm table-borderless mt-4">
                            <tr class="font-weight-bold"><td>INGRESOS OPERACIONALES</td><td/></tr>
                            <tr><td class="pl-3">Ventas Netas (70)</td><td class="text-right"><span t-esc="ventas or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                            <tr><td class="pl-3">Otros Ingresos (75, 77)</td><td class="text-right"><span t-esc="otros_ingresos or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                            
                            <tr class="font-weight-bold mt-2"><td>GASTOS OPERACIONALES</td><td/></tr>
                            <tr><td class="pl-3">Compras (60)</td><td class="text-right text-danger">(<span t-esc="compras or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr><td class="pl-3">Variación de Existencias (61)</td><td class="text-right text-danger">(<span t-esc="variacion_inv or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr><td class="pl-3">Gastos de Personal (62)</td><td class="text-right text-danger">(<span t-esc="personal or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr><td class="pl-3">Servicios Prestados por Terceros (63)</td><td class="text-right text-danger">(<span t-esc="servicios or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr><td class="pl-3">Tributos (64)</td><td class="text-right text-danger">(<span t-esc="tributos or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr><td class="pl-3">Cargas Diversas de Gestión (65)</td><td class="text-right text-danger">(<span t-esc="otros_gastos or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>

                            <tr class="font-weight-bold table-light mt-2"><td>RESULTADO DE OPERACIÓN</td><td class="text-right"><span t-esc="utilidad_operativa or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                            <tr><td>Gastos Financieros (67)</td><td class="text-right text-danger">(<span t-esc="financieros or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr class="font-weight-bold table-dark text-white"><td>RESULTADO NETO DEL EJERCICIO</td><td class="text-right"><span t-esc="utilidad_neta or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                        </table>
                    </t>

                    <t t-if="data['report_type'] == 'diario'">
                        <table class="table table-sm" style="font-size: 10px;">
                            <thead>
                                <tr class="table-dark text-white">
                                    <th>Fecha</th>
                                    <th>Asiento</th>
                                    <th>Cuenta</th>
                                    <th>Descripción (Glosa)</th>
                                    <th class="text-right">Debe</th>
                                    <th class="text-right">Haber</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="asientos" t-as="l">
                                    <td><span t-field="l.date"/></td>
                                    <td><span t-field="l.move_id.name"/></td>
                                    <td><span t-field="l.account_id.code"/></td>
                                    <td><span t-field="l.name"/></td>
                                    <td class="text-right"><span t-esc="l.debit or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-right"><span t-esc="l.credit or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <t t-if="data['report_type'] == 'mayor'">
                        <t t-foreach="cuentas_mayor" t-as="c">
                            <div style="page-break-inside: avoid; margin-bottom: 20px;">
                                <h6 class="bg-light p-2 font-weight-bold border">
                                    Cuenta: <span t-esc="c['code']"/> - <span t-esc="c['name']"/> 
                                    <span class="float-right">Saldo Inicial: <span t-esc="c['inicial'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></span>
                                </h6>
                                <table class="table table-sm" style="font-size: 10px;">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Asiento</th>
                                            <th>Glosa</th>
                                            <th class="text-right">Debe</th>
                                            <th class="text-right">Haber</th>
                                            <th class="text-right">Saldo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="running_balance" t-value="c['inicial']"/>
                                        <tr t-foreach="c['movimientos']" t-as="m">
                                            <t t-set="running_balance" t-value="running_balance + (m.debit - m.credit)"/>
                                            <td><span t-field="m.date"/></td>
                                            <td><span t-field="m.move_id.name"/></td>
                                            <td><span t-field="m.name"/></td>
                                            <td class="text-right"><span t-esc="m.debit or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="text-right"><span t-esc="m.credit or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="text-right"><span t-esc="running_balance or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-weight-bold table-active">
                                            <td colspan="5" class="text-right">Saldo Final:</td>
                                            <td class="text-right"><span t-esc="c['final'] or 0.0" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </t>
                    </t>

                    <t t-if="data['report_type'] == 'flujo'">
                        <table class="table table-sm mt-4">
                            <tr class="font-weight-bold table-active"><td>CONCEPTO</td><td class="text-right">MONTO</td></tr>
                            <tr><td class="pl-3">Entradas de Efectivo (Cobros)</td><td class="text-right text-success"><span t-esc="entradas or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                            <tr><td class="pl-3">Salidas de Efectivo (Pagos)</td><td class="text-right text-danger">(<span t-esc="salidas or 0.0" t-options='{"widget": "float", "precision": 2}'/>)</td></tr>
                            <tr class="font-weight-bold border-top"><td>Aumento (Disminución) Neto de Efectivo</td><td class="text-right"><span t-esc="flujo_neto or 0.0" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                        </table>
                        <p class="text-muted text-center mt-2" style="font-size: 10px;">* Basado en movimientos de Caja y Bancos.</p>
                    </t>

                    <t t-if="data['report_type'] == 'notas'">
                        <div class="mt-4 p-3 border">
                            <t t-raw="notas_html or 'Sin notas registradas.'"/>
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </template>
</odoo>