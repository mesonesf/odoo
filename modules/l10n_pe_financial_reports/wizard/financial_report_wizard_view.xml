<odoo>
    <record id="view_financial_report_wizard" model="ir.ui.view">
        <field name="name">financial.report.wizard.form</field>
        <field name="model">financial.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="report_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" string="Generar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Reportes Contables Perú</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_finance_reports_peru" 
              name="Reportes Financieros (SUNAT)" 
              parent="account.menu_finance_reports" 
              action="action_financial_report_wizard" 
              sequence="100"/>
</odoo>