<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Herencia de Formulario CRM Lead / Oportunidad (crm.crm_lead_view_form) -->
    <record id="crm_lead_view_form_conagra_whatsapp" model="ir.ui.view">
        <field name="name">crm.lead.view.form.conagra.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_whatsapp_channel"
                        string="Abrir Chat WhatsApp"
                        type="object"
                        class="btn-success"
                        icon="fa-whatsapp"
                        invisible="not discuss_channel_id"/>
                <button name="action_send_ficha_tecnica_whatsapp"
                        string="Enviar Ficha Técnica PDF (WA)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-pdf-o"
                        invisible="not discuss_channel_id"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']" position="after">
                <group name="whatsapp_conagra_info" string="Calificación Bot WhatsApp (Silverio)">
                    <field name="wa_zona_id"/>
                    <field name="wa_cultivo_id"/>
                    <field name="wa_zona" placeholder="Texto zona capturado..."/>
                    <field name="wa_cultivo" placeholder="Texto cultivo capturado..."/>
                    <field name="wa_codigo_herramienta" placeholder="Ej. Hoyadora DGD800 / Root Plex"/>
                    <field name="discuss_channel_id" readonly="1" options="{'no_create': True}"/>
                    <field name="ficha_product_id" options="{'no_create': True}"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='lead_info']" position="after">
                <group name="whatsapp_conagra_lead_info" string="Calificación Bot WhatsApp (Silverio)" invisible="type == 'opportunity'">
                    <field name="wa_zona_id"/>
                    <field name="wa_cultivo_id"/>
                    <field name="wa_zona"/>
                    <field name="wa_cultivo"/>
                    <field name="wa_codigo_herramienta"/>
                    <field name="discuss_channel_id" readonly="1" options="{'no_create': True}"/>
                    <field name="ficha_product_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 2. Herencia Equipo de Ventas (crm.team) para mapear Zonas de CONAGRA -->
    <record id="crm_team_view_form_conagra_zones" model="ir.ui.view">
        <field name="name">crm.team.view.form.conagra.zones</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="conagra_zone_keywords" placeholder="Ej. Piura, Sullana, Tambo Grande"/>
            </xpath>
        </field>
    </record>

    <!-- 3. Herencia de Canal de Conversación (discuss.channel) + Central Telefónica CONAGRA -->
    <record id="discuss_channel_view_form_conagra" model="ir.ui.view">
        <field name="name">discuss.channel.view.form.conagra</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bot Silverio &amp; Control SLA (CONAGRA)" invisible="channel_type != 'gateway'">
                    <group>
                        <field name="bot_state"/>
                        <field name="wa_temp_name"/>
                        <field name="wa_temp_zone"/>
                        <field name="wa_temp_crop"/>
                    </group>
                    <group>
                        <field name="crm_lead_id"/>
                        <field name="assigned_user_id"/>
                        <field name="wa_last_customer_msg_dt"/>
                        <field name="wa_waiting_minutes"/>
                        <field name="wa_sla_semaphore" widget="badge"
                               decoration-success="wa_sla_semaphore == 'green'"
                               decoration-warning="wa_sla_semaphore == 'yellow'"
                               decoration-danger="wa_sla_semaphore == 'red'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="discuss_channel_view_list_conagra_cockpit" model="ir.ui.view">
        <field name="name">discuss.channel.view.list.conagra.cockpit</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list string="Central Telefónica WhatsApp CONAGRA"
                  decoration-danger="wa_sla_semaphore == 'red'"
                  decoration-warning="wa_sla_semaphore == 'yellow'"
                  decoration-success="wa_sla_semaphore == 'green'">
                <field name="name"/>
                <field name="bot_state" widget="badge"/>
                <field name="wa_temp_name"/>
                <field name="wa_temp_zone"/>
                <field name="wa_temp_crop"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="crm_lead_id"/>
                <field name="wa_waiting_minutes"/>
                <field name="wa_sla_semaphore" widget="badge"
                       decoration-success="wa_sla_semaphore == 'green'"
                       decoration-warning="wa_sla_semaphore == 'yellow'"
                       decoration-danger="wa_sla_semaphore == 'red'"/>
            </list>
        </field>
    </record>

    <record id="action_conagra_whatsapp_central_cockpit" model="ir.actions.act_window">
        <field name="name">Central Telefónica WhatsApp (Silverio)</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="discuss_channel_view_list_conagra_cockpit"/>
        <field name="domain">[('channel_type', '=', 'gateway')]</field>
    </record>

    <menuitem id="menu_conagra_whatsapp_central_cockpit"
              name="Central Telefónica WhatsApp"
              parent="crm.crm_menu_root"
              action="action_conagra_whatsapp_central_cockpit"
              sequence="5"/>
</odoo>
