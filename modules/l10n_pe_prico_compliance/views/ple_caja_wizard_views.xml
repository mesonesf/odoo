<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_caja_wizard_form" model="ir.ui.view">
        <field name="name">ple.caja.wizard.form</field>
        <field name="model">ple.caja.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar PLE 1.1 y 1.2">
                
                <group invisible="state != 'choose'">
                    <div class="alert alert-info text-center" role="alert" colspan="2">
                        <strong>Libros de Efectivo y Cuentas Bancarias</strong><br/>
                        Asegúrese de haber conciliado sus extractos bancarios del mes antes de exportar.
                    </div>
                    <group colspan="2">
                        <field name="book_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                
                <group invisible="state != 'get'">
                    <div class="alert alert-success text-center" role="alert" colspan="2">
                        <strong>¡Libro Generado Exitosamente!</strong>
                    </div>
                    <field name="txt_filename" invisible="1"/>
                    <field name="txt_binary" filename="txt_filename" widget="binary" nolabel="1" class="oe_inline"/>
                </group>

                <footer>
                    <button name="action_generate_ple_1" string="Generar TXT SUNAT" type="object" class="btn-primary" invisible="state != 'choose'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ple_caja_wizard" model="ir.actions.act_window">
        <field name="name">PLE 1.1 y 1.2 (Caja y Bancos)</field>
        <field name="res_model">ple.caja.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>