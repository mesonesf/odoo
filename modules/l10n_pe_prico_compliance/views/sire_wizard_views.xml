<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_wizard_form" model="ir.ui.view">
        <field name="name">sire.wizard.form</field>
        <field name="model">sire.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar SIRE (RVIE / RCE)">
                
                <group invisible="state != 'choose'">
                    <div class="alert alert-info text-center" role="alert" colspan="2">
                        <strong>Sistema Integrado de Registros Electrónicos (SIRE)</strong><br/>
                        Genera el archivo TXT para proponer o reemplazar el registro en el portal de SUNAT.
                    </div>
                    <group colspan="2">
                        <field name="book_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                
                <group invisible="state != 'get'">
                    <div class="alert alert-success text-center" role="alert" colspan="2">
                        <strong>¡Reportes SIRE Generados Exitosamente!</strong>
                    </div>
                    
                    <group string="Archivo Validador SUNAT">
                        <field name="txt_filename" invisible="1"/>
                        <field name="txt_binary" filename="txt_filename" widget="binary" nolabel="1" class="oe_inline"/>
                    </group>
                    
                    <group string="Auditoría Visual">
                        <field name="xls_filename" invisible="1"/>
                        <field name="xls_binary" filename="xls_filename" widget="binary" nolabel="1" class="oe_inline"/>
                    </group>
                </group>

                <footer>
                    <button name="action_generate_sire" string="Generar TXT SUNAT" type="object" class="btn-primary" invisible="state != 'choose'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sire_wizard" model="ir.actions.act_window">
        <field name="name">SIRE (Ventas y Compras)</field>
        <field name="res_model">sire.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>