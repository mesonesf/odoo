<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_l10n_pe_prico" model="ir.ui.view">
        <field name="name">account.tax.form.l10n.pe.prico</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='tax_group_id']" position="after">
                <field name="l10n_pe_edi_affectation_reason" 
                       options="{'no_create': True}" 
                       placeholder="Ej: 10 - Gravado - Operación Onerosa"/>
            </xpath>
            
        </field>
    </record>
</odoo>