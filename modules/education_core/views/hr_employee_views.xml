<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_education" model="ir.ui.view">
        <field name="name">hr.employee.education.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Perfil Docente" name="education_teacher_info">
                    <group>
                        <field name="is_teacher"/>
                        <field name="academic_degree" invisible="not is_teacher"/>
                        <field name="specialty" invisible="not is_teacher"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_education_teacher" model="ir.actions.act_window">
        <field name="name">Docentes</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_teacher', '=', True)]</field>
        <field name="context">{'default_is_teacher': True}</field>
    </record>
</odoo>