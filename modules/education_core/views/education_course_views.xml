<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_course_form" model="ir.ui.view">
        <field name="name">education.course.form</field>
        <field name="model">education.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del Curso"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="credits"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_course_list" model="ir.ui.view">
        <field name="name">education.course.list</field>
        <field name="model">education.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="credits"/>
            </list>
        </field>
    </record>

    <record id="action_education_course" model="ir.actions.act_window">
        <field name="name">Cursos y Materias</field>
        <field name="res_model">education.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>